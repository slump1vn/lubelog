@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model AssistantPanelViewModel
@{
    var userLanguage = config.GetUserConfig(User).UserLanguage;
    string T(string text) => translator.Translate(userLanguage, text);
    bool modelConfigured = Model.ModelConfigured;
}
<div class="d-flex flex-column h-100">
    <div class="px-3 pt-2 small">
        @if (modelConfigured)
        {
            <span class="badge bg-success">@T("Home AI: On")</span>
        }
        else
        {
            <span class="badge bg-secondary" title="LUBELOGGER_AI_URL">@T("Home AI: Off (basic parser only)")</span>
        }
    </div>
    <div id="assistantMessages" class="flex-grow-1 overflow-auto px-3 py-2" role="log" aria-live="polite" aria-label="@T("Conversation")">
        <div id="assistantOlder" class="text-center mb-2 d-none">
            <button type="button" class="btn btn-sm btn-link" onclick="loadAssistantHistory(true)">@T("Show older messages")</button>
        </div>
        <div id="assistantWelcome" class="text-body-secondary small mb-2">
            <div class="mb-1">@T("Ask about the joint account, the budget or your vehicles. For example:")</div>
            <ul class="mb-1 ps-3">
                <li>Tài khoản chung còn bao nhiêu?</li>
                <li>Tháng trước chi bao nhiêu?</li>
                <li>Tìm giao dịch grab</li>
                @if (Model.Vehicles.Any())
                {
                    <li>Hôm nay thay nhớt Vision ở 12.350km hết 120k</li>
                }
            </ul>
            @if (modelConfigured)
            {
                <div><i class="bi bi-camera me-1"></i>@T("Or send a photo of a receipt, a bank transfer or a food label")</div>
            }
        </div>
    </div>
    <div id="assistantSuggestions" class="d-flex flex-wrap gap-1 px-3 pb-2" aria-label="@T("Suggestions")">
        @foreach (var suggestion in Model.Suggestions)
        {
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill assistant-chip" onclick="sendAssistantSuggestion(this)">@suggestion</button>
        }
    </div>
    <div class="border-top px-3 py-2">
        <div class="input-group">
            <input type="file" id="assistantImageInput" accept="image/png,image/jpeg" class="d-none" onchange="sendAssistantImage(this)">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="assistantImageButton" data-bs-toggle="dropdown" aria-expanded="false" title="@T("Send a photo")" aria-label="@T("Send a photo")" @(modelConfigured ? "" : "disabled")><i class="bi bi-camera"></i></button>
            <ul class="dropdown-menu">
                <li><button class="dropdown-item" type="button" onclick="pickAssistantImage('')"><i class="bi bi-receipt me-2"></i>@T("Receipt or bank transfer")</button></li>
                <li><button class="dropdown-item" type="button" onclick="pickAssistantImage('food')"><i class="bi bi-upc-scan me-2"></i>@T("Food label")</button></li>
            </ul>
            <input type="text" id="assistantInput" class="form-control" autocomplete="off" maxlength="1000" enterkeyhint="send" placeholder="@T("Type a message")" aria-label="@T("Type a message")" onkeydown="if (event.key === 'Enter' && !event.isComposing) { event.preventDefault(); sendAssistantMessage(); }">
            <button class="btn btn-primary" type="button" id="assistantSend" onclick="sendAssistantMessage()" aria-label="@T("Send")"><i class="bi bi-send"></i></button>
        </div>
        <div class="small text-body-secondary mt-1">@T("Answers are read from your data; nothing is saved until you press Save. History is kept for 30 days.")</div>
    </div>
</div>
<template id="assistantFoodTemplate">
    <div class="d-flex justify-content-start mb-2 assistant-food-actions">
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAssistantFoodCheck(this)"><i class="bi bi-pencil-square me-1"></i>@T("Check and save in Food labels")</button>
    </div>
</template>
<template id="assistantDraftTemplate">
    <div class="card mb-2 assistant-draft">
        <div class="card-body">
            <div class="assistant-warnings text-warning-emphasis small mb-2"></div>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Type")</label>
                    <select class="form-select form-select-sm draft-intent" onchange="updateAssistantDraftFields(this)">
                        <option value="1">@translator.Translate(userLanguage, "Service")</option>
                        <option value="2">@translator.Translate(userLanguage, "Fuel")</option>
                        <option value="3">@translator.Translate(userLanguage, "Other Expenses")</option>
                        <option value="4">@translator.Translate(userLanguage, "Odometer")</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Vehicle")</label>
                    <select class="form-select form-select-sm draft-vehicle">
                        <option value="0">---</option>
                        @foreach (Vehicle vehicle in Model.Vehicles)
                        {
                            <option value="@vehicle.Id">@($"{vehicle.Make} {vehicle.Model} ({vehicle.LicensePlate})")</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Date")</label>
                    <input type="text" class="form-control form-control-sm draft-date">
                </div>
                <div class="col-6 draft-field-mileage">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Odometer")</label>
                    <input type="number" min="0" step="1" inputmode="numeric" class="form-control form-control-sm draft-mileage">
                </div>
                <div class="col-6 draft-field-fuel">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Fuel Consumption")</label>
                    <input type="number" min="0" step="any" inputmode="decimal" class="form-control form-control-sm draft-fuel">
                </div>
                <div class="col-6 draft-field-cost">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Cost")</label>
                    <input type="number" min="0" step="any" inputmode="decimal" class="form-control form-control-sm draft-cost">
                </div>
                <div class="col-12 draft-field-description">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Description")</label>
                    <input type="text" class="form-control form-control-sm draft-description">
                </div>
                <div class="col-12 draft-field-tags">
                    <label class="form-label small mb-0">@translator.Translate(userLanguage, "Tags")</label>
                    <input type="text" class="form-control form-control-sm draft-tags">
                </div>
                <div class="col-12 draft-field-full">
                    <div class="form-check">
                        <input class="form-check-input draft-full" type="checkbox">
                        <label class="form-check-label small">@translator.Translate(userLanguage, "Is Filled To Full")</label>
                    </div>
                </div>
            </div>
            <div class="form-check mt-2 draft-field-attach" style="display:none;">
                <input class="form-check-input draft-attach" type="checkbox">
                <label class="form-check-label small">@translator.Translate(userLanguage, "Keep the photo with the record")</label>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-2 draft-actions">
                <button type="button" class="btn btn-sm btn-secondary" onclick="cancelAssistantDraft(this)">@translator.Translate(userLanguage, "Cancel")</button>
                <button type="button" class="btn btn-sm btn-primary" onclick="saveAssistantDraft(this)">@translator.Translate(userLanguage, "Save")</button>
            </div>
            <div class="draft-status small text-success" style="display:none;"><i class="bi bi-check-circle me-1"></i>@translator.Translate(userLanguage, "Saved")</div>
            <div class="draft-cancelled small text-body-secondary" style="display:none;">@translator.Translate(userLanguage, "Cancelled")</div>
        </div>
    </div>
</template>
<template id="assistantMatchTemplate">
    <div class="card mb-2 assistant-matches">
        <div class="card-body">
            <div class="small mb-2 match-summary"></div>
            <div class="fw-bold small mb-1">@translator.Translate(userLanguage, "This transfer may be the payment for:")</div>
            <div class="list-group mb-2 match-list"></div>
            <div class="small text-body-secondary match-hint">@translator.Translate(userLanguage, "Or save it as a new expense below")</div>
            <div class="match-status small text-success" style="display:none;"><i class="bi bi-check-circle me-1"></i>@translator.Translate(userLanguage, "Marked as paid")</div>
        </div>
    </div>
</template>
<span id="assistantMarkPaidLabel" class="d-none">@translator.Translate(userLanguage, "Mark as paid")</span>
