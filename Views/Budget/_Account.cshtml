@using CarCareTracker.Helper
@using System.Globalization
@inject IConfigHelper config
@inject ITranslationHelper translator
@model SharedAccountViewModel
@{
    var userLanguage = config.GetUserConfig(User).UserLanguage;
    string T(string text) => translator.Translate(userLanguage, text);
    string Money(long value) => value.ToString("N0", CultureInfo.CurrentCulture) + " ₫";
    string Utc(DateTime value) => DateTime.SpecifyKind(value.ToUniversalTime(), DateTimeKind.Utc).ToString("o", CultureInfo.InvariantCulture);
    var hasAccount = !string.IsNullOrEmpty(Model.Account.AccountNumber);
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>
            <i class="bi bi-bank me-1"></i>@T("Shared account")
            @if (hasAccount)
            {
                <span class="text-muted ms-1">@Model.Account.BankName @Model.Account.AccountNumber</span>
            }
        </span>
        @if (hasAccount && Model.ApiConfigured)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="syncBudgetAccount(this)"><i class="bi bi-arrow-repeat me-1"></i>@T("Sync now")</button>
        }
    </div>
    <div class="card-body">
        @if (!hasAccount)
        {
            <p class="mb-0 text-muted">@T("Enter the shared account number under General and save to follow it here.")</p>
        }
        else
        {
            @if (!Model.ApiConfigured && !Model.WebhookConfigured)
            {
                <div class="alert alert-warning mb-2">@T("SePay is not connected yet. Set LUBELOGGER_SEPAY_API_KEY (and optionally LUBELOGGER_SEPAY_WEBHOOK_SECRET) on the server.")</div>
            }
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <div class="text-muted small">@T("Balance")</div>
                    <div class="fs-4">@(Model.Balance.HasValue ? Money(Model.Balance.Value) : "---")</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">@string.Format(T("Money in since {0}"), Model.CycleStart.ToString("d", CultureInfo.CurrentCulture))</div>
                    <div class="fs-4 text-success">@Money(Model.CycleIn)</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">@string.Format(T("Money out since {0}"), Model.CycleStart.ToString("d", CultureInfo.CurrentCulture))</div>
                    <div class="fs-4 text-danger">@Money(Model.CycleOut)</div>
                </div>
            </div>
            <div class="small text-muted mt-2">
                @if (Model.WebhookConfigured)
                {
                    <span class="me-3"><i class="bi bi-lightning-charge me-1"></i>@T("Instant updates (webhook) on")</span>
                }
                @if (Model.SyncMinutes > 0)
                {
                    <span class="me-3"><i class="bi bi-clock-history me-1"></i>@string.Format(T("Checks SePay every {0} minutes"), Model.SyncMinutes)</span>
                }
                @if (Model.LastSync?.LastRunUtc != null)
                {
                    <span class="@(Model.LastSync.Succeeded ? "" : "text-danger")">
                        @T("Last check"): <time class="budget-time" datetime="@Utc(Model.LastSync.LastRunUtc.Value)">@Model.LastSync.LastRunUtc.Value.ToString("u")</time>
                        @if (!Model.LastSync.Succeeded)
                        {
                            <span>(@T(Model.LastSync.Error))</span>
                        }
                    </span>
                }
            </div>
            @if (Model.Recent.Any())
            {
                <div class="table-responsive mt-2">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">@T("Time")</th>
                                <th scope="col">@T("Content")</th>
                                <th scope="col" class="text-end">@T("Amount")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model.Recent)
                            {
                                <tr>
                                    <td class="text-nowrap"><time class="budget-time" datetime="@Utc(transaction.OccurredAtUtc)">@transaction.OccurredAtUtc.ToString("u")</time></td>
                                    <td class="text-break">@transaction.Content</td>
                                    <td class="text-end text-nowrap @(transaction.Direction == TransferDirection.In ? "text-success" : "text-danger")">@(transaction.Direction == TransferDirection.In ? "+" : "-")@Money(transaction.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 mt-2 text-muted">@T("No transactions yet.")</p>
            }
        }
    </div>
</div>
