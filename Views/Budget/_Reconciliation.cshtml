@using CarCareTracker.Helper
@using CarCareTracker.Logic
@using System.Globalization
@inject IConfigHelper config
@inject ITranslationHelper translator
@model ReconciliationViewModel
@{
    var userLanguage = config.GetUserConfig(User).UserLanguage;
    string T(string text) => translator.Translate(userLanguage, text);
    string Money(long value) => value.ToString("N0", CultureInfo.CurrentCulture) + " ₫";
    string Utc(DateTime value) => DateTime.SpecifyKind(value.ToUniversalTime(), DateTimeKind.Utc).ToString("o", CultureInfo.InvariantCulture);
    string VietnamDate(DateTime utc) => SepayRules.ToVietnamTime(utc).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var unexplainedOut = Model.Gaps.Where(x => x.Amount < 0).Sum(x => x.AbsoluteAmount);
    var unexplainedIn = Model.Gaps.Where(x => x.Amount > 0).Sum(x => x.AbsoluteAmount);
}
<div class="card" id="budgetReconciliationCard">
    <div class="card-header"><i class="bi bi-clipboard-check me-1"></i>@T("Reconciliation")</div>
    <div class="card-body">
        @if (!Model.HasAccount)
        {
            <p class="mb-0 text-muted">@T("Enter the shared account number under General and save to follow it here.")</p>
        }
        else
        {
            <p class="small text-muted">@T("The bank balance is the truth: every change of it must be explained by a transaction. SePay on the free plan only reports transfers with the SEVQR code, so card payments and other transfers show up here as differences. Explain them by category, or import the bank statement to fill them in.")</p>
            @if (!Model.Gaps.Any())
            {
                <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-1"></i>@T("No differences: the balance matches the recorded transactions.")</div>
            }
            else
            {
                <div class="alert alert-warning mb-2">
                    <i class="bi bi-exclamation-triangle me-1"></i>@string.Format(T("{0} unexplained differences"), Model.Gaps.Count)
                    @if (unexplainedOut > 0)
                    {
                        <span class="ms-2">@T("Money out"): <strong class="text-danger">-@Money(unexplainedOut)</strong></span>
                    }
                    @if (unexplainedIn > 0)
                    {
                        <span class="ms-2">@T("Money in"): <strong class="text-success">+@Money(unexplainedIn)</strong></span>
                    }
                </div>
                <ul class="list-group mb-3">
                    @foreach (var gap in Model.Gaps.Take(50))
                    {
                        <li class="list-group-item" data-gap-key="@gap.Key">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="small">
                                    <div>
                                        <time class="budget-time" datetime="@Utc(gap.FromUtc)">@gap.FromUtc.ToString("u")</time>
                                        →
                                        <time class="budget-time" datetime="@Utc(gap.ToUtc)">@gap.ToUtc.ToString("u")</time>
                                    </div>
                                    <div class="text-muted">@T("Balance"): @Money(gap.BalanceBefore) → @Money(gap.BalanceAfter)</div>
                                </div>
                                <div class="text-end text-nowrap">
                                    <div class="fw-semibold @(gap.Amount < 0 ? "text-danger" : "text-success")">@(gap.Amount < 0 ? "-" : "+")@Money(gap.AbsoluteAmount)</div>
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1" onclick="toggleGapForm('@gap.Key')"><i class="bi bi-pencil me-1"></i>@T("Explain")</button>
                                </div>
                            </div>
                            <div class="gap-form mt-2" style="display:none">
                                <div class="row g-2">
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small mb-0">@T("Amount")</label>
                                        <input type="number" class="form-control form-control-sm gap-amount" min="1" max="@gap.AbsoluteAmount" step="1" value="@gap.AbsoluteAmount">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small mb-0">@T("Date")</label>
                                        <input type="date" class="form-control form-control-sm gap-date" value="@VietnamDate(gap.ToUtc)" min="@VietnamDate(gap.FromUtc)" max="@VietnamDate(gap.ToUtc)">
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small mb-0">@T("Category")</label>
                                        <select class="form-select form-select-sm gap-category">
                                            @foreach (var category in Model.Categories)
                                            {
                                                <option value="@category">@T(category)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <input type="text" class="form-control form-control-sm gap-note" maxlength="300" placeholder="@T("Note (optional)")">
                                    </div>
                                    <div class="col-12 d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-primary text-nowrap" onclick="saveGapExplanation('@gap.Key')"><i class="bi bi-check me-1"></i>@T("Save")</button>
                                        <span class="small text-muted align-self-center">@T("Several entries can split one difference into categories.")</span>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
            @if (Model.ManualEntries.Any())
            {
                <h6 class="mt-3">@T("Explained by hand")</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var entry in Model.ManualEntries)
                            {
                                <tr>
                                    <td class="text-nowrap small"><time class="budget-time" datetime="@Utc(entry.OccurredAtUtc)">@entry.OccurredAtUtc.ToString("u")</time></td>
                                    <td class="small text-break">@T(entry.Category)@(string.IsNullOrEmpty(entry.Note) ? "" : " · " + entry.Note)</td>
                                    <td class="text-end text-nowrap @(entry.Direction == CarCareTracker.Models.TransferDirection.In ? "text-success" : "text-danger")">@(entry.Direction == CarCareTracker.Models.TransferDirection.In ? "+" : "-")@Money(entry.Amount)</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger p-0" title="@T("Delete")" onclick="deleteManualEntry(@entry.Id)"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <h6 class="mt-3"><i class="bi bi-file-earmark-spreadsheet me-1"></i>@T("Import bank statement")</h6>
            <p class="small text-muted mb-2">
                @T("Export the statement of the shared account from the bank app or internet banking as Excel (.xlsx) or .csv, then choose it here. Lines already in the app are skipped, so the same statement can be imported again safely.")
                @if (Model.StatementTransactions > 0 && Model.LastStatementTransactionUtc.HasValue)
                {
                    <br />@string.Format(T("{0} transactions from statements so far, the latest on"), Model.StatementTransactions) <time class="budget-time" datetime="@Utc(Model.LastStatementTransactionUtc.Value)">@Model.LastStatementTransactionUtc.Value.ToString("u")</time>
                }
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="file" class="form-control form-control-sm" style="max-width:320px" id="statementFile" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="importStatement(false, this)"><i class="bi bi-eye me-1"></i>@T("Preview")</button>
                <button type="button" class="btn btn-sm btn-primary" id="statementApply" style="display:none" onclick="importStatement(true, this)"><i class="bi bi-upload me-1"></i>@T("Import")</button>
            </div>
            <div id="statementResult" class="mt-2"
                 data-new="@T("New")" data-known="@T("Already recorded")" data-replace="@T("Replaces manual entry")"
                 data-columns="@T("Columns understood")" data-skipped="@T("Lines without a transaction skipped")"></div>
        }
    </div>
</div>
