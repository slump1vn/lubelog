@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model BudgetSettingsViewModel
@{
    var userLanguage = config.GetUserConfig(User).UserLanguage;
    var profile = Model.Profile;
    string T(string text) => translator.Translate(userLanguage, text);
    var kinds = new List<(FundKind Kind, string Name)>
    {
        (FundKind.Shared, T("Shared fund")),
        (FundKind.Personal, T("Personal fund")),
        (FundKind.Debt, T("Debt payments")),
        (FundKind.Emergency, T("Emergency fund")),
        (FundKind.Savings, T("Savings"))
    };
    string Selected(bool condition) => condition ? "selected" : "";
}
<div id="budgetSettings" class="mt-2" data-has-profile="@(Model.HasProfile ? "true" : "false")" data-confirm-template="@T("Replace the form with the template? Nothing is saved until you press Save.")" data-confirm="@T("Yes")" data-cancel="@T("Cancel")">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="lead">@T("Household Budget")</span>
            @if (Model.IsTemplate)
            {
                <span class="badge bg-info text-dark">@T("Template, not saved yet")</span>
            }
            else if (Model.HasProfile)
            {
                <span class="badge bg-success">@T("Saved")</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">@T("Not saved yet")</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="loadBudgetTemplate()"><i class="bi bi-file-earmark-text me-1"></i>@T("Use the 25 million template")</button>
            <button type="button" class="btn btn-primary" onclick="saveBudget()"><i class="bi bi-save me-1"></i>@T("Save")</button>
        </div>
    </div>
    <div id="budgetMessages" class="mt-2" role="status" aria-live="polite">
        @if (Model.Errors.Any())
        {
            <div class="alert alert-warning mb-0">
                <ul class="mb-0">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
    <div class="row mt-2 g-2">
        <div class="col-12 col-md-4">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">@T("Total income per month")</div>
                <div class="fs-4" id="budgetTotalIncome">0</div>
            </div></div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">@T("Total put into funds")</div>
                <div class="fs-4" id="budgetTotalFunds">0</div>
            </div></div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">@T("Not allocated")</div>
                <div class="fs-4" id="budgetUnallocated">0</div>
            </div></div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">@T("General")</div>
        <div class="card-body row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label" for="budgetCurrency">@T("Currency")</label>
                <input type="text" class="form-control" id="budgetCurrency" value="@profile.Currency" maxlength="3" readonly>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="budgetThreshold">@T("Unplanned spending that needs approval, from")</label>
                <input type="number" inputmode="numeric" min="1" step="1" class="form-control" id="budgetThreshold" value="@profile.ApprovalThreshold">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="budgetCycleStart">@T("Budget cycle starts on day")</label>
                <input type="number" inputmode="numeric" min="1" max="31" step="1" class="form-control" id="budgetCycleStart" value="@profile.CycleStartDay">
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@T("Funds")</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBudgetRow('fund')"><i class="bi bi-plus-lg"></i> @T("Add")</button>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>@T("Name")</th><th>@T("Type")</th><th>@T("Per month")</th><th>@T("Target")</th><th>@T("Owner")</th><th><span class="visually-hidden">@T("Delete")</span></th></tr></thead>
                <tbody id="budgetFundRows">
                    @foreach (var fund in profile.Funds)
                    {
                        <tr class="budget-fund" data-key="@fund.Key">
                            <td><input type="text" class="form-control fund-name" value="@fund.Name" aria-label="@T("Name")"></td>
                            <td>
                                <select class="form-select fund-kind" aria-label="@T("Type")">
                                    @foreach (var kind in kinds)
                                    {
                                        <!option value="@((int)kind.Kind)" @Selected(kind.Kind == fund.Kind)>@kind.Name</!option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control fund-amount" value="@fund.MonthlyAmount" aria-label="@T("Per month")"></td>
                            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control fund-target" value="@fund.TargetAmount" aria-label="@T("Target")"></td>
                            <td>
                                <select class="form-select fund-owner" aria-label="@T("Owner")">
                                    <!option value="0" @Selected(fund.OwnerUserId == 0)>---</!option>
                                    @foreach (var member in Model.UserNames)
                                    {
                                        <!option value="@member.Key" @Selected(member.Key == fund.OwnerUserId)>@member.Value</!option>
                                    }
                                </select>
                            </td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">@T("Personal funds are only recorded as a monthly transfer. The app never tracks what they are spent on.")</div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@T("Spending limits inside a fund")</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBudgetRow('category')"><i class="bi bi-plus-lg"></i> @T("Add")</button>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>@T("Fund")</th><th>@T("Name")</th><th>@T("Limit per month")</th><th><span class="visually-hidden">@T("Delete")</span></th></tr></thead>
                <tbody id="budgetCategoryRows">
                    @foreach (var fund in profile.Funds)
                    {
                        foreach (var category in fund.Categories)
                        {
                            <tr class="budget-category" data-key="@category.Key">
                                <td><select class="form-select fund-ref" data-selected="@fund.Key" aria-label="@T("Fund")"></select></td>
                                <td><input type="text" class="form-control category-name" value="@category.Name" aria-label="@T("Name")"></td>
                                <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control category-limit" value="@category.MonthlyLimit" aria-label="@T("Limit per month")"></td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@T("Paydays")</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBudgetRow('income')"><i class="bi bi-plus-lg"></i> @T("Add")</button>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>@T("Name")</th><th>@T("Amount")</th><th>@T("Day of month")</th><th><span class="visually-hidden">@T("Delete")</span></th></tr></thead>
                <tbody id="budgetIncomeRows">
                    @foreach (var income in profile.Incomes)
                    {
                        <tr class="budget-income" data-key="@income.Key">
                            <td><input type="text" class="form-control income-name" value="@income.Name" aria-label="@T("Name")"></td>
                            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control income-amount" value="@income.Amount" aria-label="@T("Amount")"></td>
                            <td><input type="number" inputmode="numeric" min="1" max="31" step="1" class="form-control income-day" value="@income.PayDay" aria-label="@T("Day of month")"></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@T("What each payday pays for, in order")</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBudgetRow('allocation')"><i class="bi bi-plus-lg"></i> @T("Add")</button>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>@T("Payday")</th><th>@T("Order")</th><th>@T("Fund")</th><th>@T("Amount")</th><th><span class="visually-hidden">@T("Delete")</span></th></tr></thead>
                <tbody id="budgetAllocationRows">
                    @foreach (var income in profile.Incomes)
                    {
                        foreach (var allocation in income.Allocations.OrderBy(x => x.Order))
                        {
                            <tr class="budget-allocation">
                                <td><select class="form-select income-ref" data-selected="@income.Key" aria-label="@T("Payday")"></select></td>
                                <td><input type="number" inputmode="numeric" min="1" step="1" class="form-control allocation-order" value="@allocation.Order" aria-label="@T("Order")"></td>
                                <td><select class="form-select fund-ref" data-selected="@allocation.FundKey" aria-label="@T("Fund")"></select></td>
                                <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control allocation-amount" value="@allocation.Amount" aria-label="@T("Amount")"></td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@T("Debts")</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBudgetRow('debt')"><i class="bi bi-plus-lg"></i> @T("Add")</button>
        </div>
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>@T("Name")</th><th>@T("Payment per month")</th><th>@T("Due day")</th><th>@T("Remaining balance")</th><th>@T("Interest rate (% per year)")</th><th>@T("Paid from")</th><th><span class="visually-hidden">@T("Delete")</span></th></tr></thead>
                <tbody id="budgetDebtRows">
                    @foreach (var debt in profile.Debts)
                    {
                        <tr class="budget-debt" data-key="@debt.Key">
                            <td><input type="text" class="form-control debt-name" value="@debt.Name" aria-label="@T("Name")"></td>
                            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control debt-payment" value="@debt.MonthlyPayment" aria-label="@T("Payment per month")"></td>
                            <td><input type="number" inputmode="numeric" min="1" max="31" step="1" class="form-control debt-day" value="@debt.DueDay" aria-label="@T("Due day")"></td>
                            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control debt-balance" value="@debt.RemainingBalance" placeholder="@T("Optional")" aria-label="@T("Remaining balance")"></td>
                            <td><input type="number" inputmode="decimal" min="0" max="100" step="0.01" class="form-control debt-rate" value="@(debt.AnnualInterestRate.HasValue ? debt.AnnualInterestRate.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" placeholder="@T("Optional")" aria-label="@T("Interest rate (% per year)")"></td>
                            <td><select class="form-select fund-ref" data-selected="@debt.FundKey" data-kind="@((int)FundKind.Debt)" aria-label="@T("Paid from")"></select></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-3 mb-4">
        <div class="card-header">@T("Recent changes")</div>
        <ul class="list-group list-group-flush">
            @if (!Model.RecentChanges.Any())
            {
                <li class="list-group-item text-muted">@T("No changes yet")</li>
            }
            @foreach (var change in Model.RecentChanges)
            {
                <li class="list-group-item d-flex justify-content-between flex-wrap gap-2">
                    <span>@(Model.UserNames.GetValueOrDefault(change.UserId, change.UserId.ToString())) · @T(change.Action == "Create" ? "Created the budget" : "Updated the budget")</span>
                    <time class="text-muted budget-time" datetime="@change.TimestampUtc.ToString("o")">@change.TimestampUtc.ToString("u")</time>
                </li>
            }
        </ul>
    </div>

    <template id="budgetTemplate-fund">
        <tr class="budget-fund" data-key="">
            <td><input type="text" class="form-control fund-name" aria-label="@T("Name")"></td>
            <td>
                <select class="form-select fund-kind" aria-label="@T("Type")">
                    @foreach (var kind in kinds)
                    {
                        <option value="@((int)kind.Kind)">@kind.Name</option>
                    }
                </select>
            </td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control fund-amount" value="0" aria-label="@T("Per month")"></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control fund-target" value="0" aria-label="@T("Target")"></td>
            <td>
                <select class="form-select fund-owner" aria-label="@T("Owner")">
                    <option value="0">---</option>
                    @foreach (var member in Model.UserNames)
                    {
                        <option value="@member.Key">@member.Value</option>
                    }
                </select>
            </td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
        </tr>
    </template>
    <template id="budgetTemplate-category">
        <tr class="budget-category" data-key="">
            <td><select class="form-select fund-ref" aria-label="@T("Fund")"></select></td>
            <td><input type="text" class="form-control category-name" aria-label="@T("Name")"></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control category-limit" value="0" aria-label="@T("Limit per month")"></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
        </tr>
    </template>
    <template id="budgetTemplate-income">
        <tr class="budget-income" data-key="">
            <td><input type="text" class="form-control income-name" aria-label="@T("Name")"></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control income-amount" value="0" aria-label="@T("Amount")"></td>
            <td><input type="number" inputmode="numeric" min="1" max="31" step="1" class="form-control income-day" value="1" aria-label="@T("Day of month")"></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
        </tr>
    </template>
    <template id="budgetTemplate-allocation">
        <tr class="budget-allocation">
            <td><select class="form-select income-ref" aria-label="@T("Payday")"></select></td>
            <td><input type="number" inputmode="numeric" min="1" step="1" class="form-control allocation-order" value="1" aria-label="@T("Order")"></td>
            <td><select class="form-select fund-ref" aria-label="@T("Fund")"></select></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control allocation-amount" value="0" aria-label="@T("Amount")"></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
        </tr>
    </template>
    <template id="budgetTemplate-debt">
        <tr class="budget-debt" data-key="">
            <td><input type="text" class="form-control debt-name" aria-label="@T("Name")"></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control debt-payment" value="0" aria-label="@T("Payment per month")"></td>
            <td><input type="number" inputmode="numeric" min="1" max="31" step="1" class="form-control debt-day" value="1" aria-label="@T("Due day")"></td>
            <td><input type="number" inputmode="numeric" min="0" step="1" class="form-control debt-balance" placeholder="@T("Optional")" aria-label="@T("Remaining balance")"></td>
            <td><input type="number" inputmode="decimal" min="0" max="100" step="0.01" class="form-control debt-rate" placeholder="@T("Optional")" aria-label="@T("Interest rate (% per year)")"></td>
            <td><select class="form-select fund-ref" data-kind="@((int)FundKind.Debt)" aria-label="@T("Paid from")"></select></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeBudgetRow(this)" aria-label="@T("Delete")"><i class="bi bi-trash"></i></button></td>
        </tr>
    </template>
</div>
