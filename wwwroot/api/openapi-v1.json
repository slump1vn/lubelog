{
  "openapi": "3.1.0",
  "info": {
    "title": "Sói & Thỏ – Family finance API",
    "version": "1.0.0",
    "description": "Read-only API v1 for the native apps. Sign in with OAuth 2.0 authorization code + PKCE (see /.well-known/oauth-authorization-server) and send the access token as `Authorization: Bearer ...`. Access tokens last 15 minutes; refresh tokens rotate on every use and must be stored in the Keychain. Dates are yyyy-MM-dd Vietnam calendar dates, times are UTC ISO 8601, money is whole VND. Errors are RFC 9457 problem details. Fields are only ever added in v1."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "oauth": [] }],
  "paths": {
    "/api/v1/me": {
      "get": {
        "summary": "Who is signed in",
        "operationId": "getMe",
        "responses": {
          "200": { "description": "The user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/dashboard": {
      "get": {
        "summary": "Home screen of the joint account for the current budget cycle",
        "operationId": "getDashboard",
        "responses": {
          "200": { "description": "Dashboard", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/transactions": {
      "get": {
        "summary": "Transactions of the joint account, newest first",
        "operationId": "listTransactions",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "cursor", "in": "query", "description": "nextCursor of the previous page, unchanged.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "One page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionPage" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/budget": {
      "get": {
        "summary": "Household budget: paydays, funds, limits and debts",
        "operationId": "getBudget",
        "responses": {
          "200": { "description": "Budget profile, same shape as the website uses", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/food/read": {
      "post": {
        "summary": "Read 1 to 3 photos of one food label with the home AI (photos are not stored)",
        "operationId": "readFoodLabel",
        "description": "Needs the Authorization: Bearer header. The user must check the reading before it is analysed.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reading, or success=false with a message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodReadResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/food/analyze": {
      "post": {
        "summary": "Rate a checked reading (UK FSA traffic lights, WHO limits, additives, allergens)",
        "operationId": "analyzeFoodLabel",
        "description": "Needs the Authorization: Bearer header. save=true adds it to the household history.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodAnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The analysis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodAnalyzeResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/food/scans": {
      "get": {
        "summary": "Saved food label scans of the household, newest first",
        "operationId": "listFoodScans",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FoodScan"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/food/scans/{id}": {
      "get": {
        "summary": "One saved scan, with the caller's own allergy marks",
        "operationId": "getFoodScan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The scan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScan"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/assistant/suggestions": {
      "get": {"summary": "Questions to show as buttons when the chat opens", "operationId": "assistantSuggestions", "responses": {"200": {"description": "Suggestions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantSuggestions"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/assistant/messages": {
      "get": {"summary": "The signed-in user's own chat history (kept 30 days)", "operationId": "assistantHistory", "description": "Each page is oldest first. Pass nextBefore back as before for older messages.", "parameters": [{"name": "before", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}}], "responses": {"200": {"description": "History page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantHistoryPage"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "post": {"summary": "Send one question or vehicle log entry; returns the answer", "operationId": "assistantSend", "description": "Needs the Authorization: Bearer header. Answers only read data: amounts are computed by the server, the AI only picks which lookup to run. A vehicle entry comes back as a draft (kind=draft) that is saved only by POST /api/v1/assistant/drafts. Text is answered in Vietnamese.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantChatRequest"}}}}, "responses": {"200": {"description": "The answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantReply"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}, "429": {"description": "Too many messages (at most 20 a minute per user); see Retry-After", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}},
      "delete": {"summary": "Delete the user's whole chat history", "operationId": "assistantClear", "description": "Needs the Authorization: Bearer header.", "responses": {"204": {"description": "Deleted"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/assistant/photo": {
      "post": {"summary": "Read one photo: receipt, bank transfer or food label", "operationId": "assistantPhoto", "description": "Needs the Authorization: Bearer header. JPEG or PNG, at most 8 MB. hint=food reads it as a food label; otherwise the receipt reader runs first and falls back to the food label reader. Receipts and transfers come back as drafts to confirm; food labels are rated but not saved (save them with POST /api/v1/food/analyze after the user checks the numbers). The photo is not kept in the history.", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary"}, "hint": {"type": "string", "enum": ["", "food"]}}}}}}, "responses": {"200": {"description": "The answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantReply"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}, "429": {"description": "Too many messages (at most 20 a minute per user); see Retry-After", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}
    },
    "/api/v1/assistant/drafts": {
      "post": {"summary": "Save a vehicle draft from an answer, after the user checked it", "operationId": "assistantSaveDraft", "description": "Needs the Authorization: Bearer header and edit access to the vehicle.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiDraft"}}}}, "responses": {"200": {"description": "success=false with a message when it could not be saved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/assistant/payments": {
      "post": {"summary": "Mark an existing vehicle record as paid by a transfer from an answer", "operationId": "assistantAttachPayment", "description": "Needs the Authorization: Bearer header and edit access to the record's vehicle. Use one of the matches of a kind=payment answer.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiAttachPaymentRequest"}}}}, "responses": {"200": {"description": "success=false with a message when it could not be saved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "description": "Public client `soitho-ios`, redirect `vn.digifusion.finance:/oauth/callback`, PKCE S256 required. Optional `device_name` form field on the code exchange names the device in Signed-in devices.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "refreshUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No token, or the token expired, or the device was signed out. Refresh once; if that fails, sign in again.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem": {
        "description": "Error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      },
      "Me": {
        "type": "object",
        "required": ["id", "userName", "householdId", "isAdmin"],
        "properties": {
          "id": { "type": "integer" },
          "userName": { "type": "string" },
          "householdId": { "type": "integer" },
          "isAdmin": { "type": "boolean" }
        }
      },
      "Direction": { "type": "string", "enum": ["in", "out"] },
      "Account": {
        "type": "object",
        "properties": {
          "linked": { "type": "boolean" },
          "bankName": { "type": "string" },
          "maskedNumber": { "type": "string", "examples": ["•••• 6789"] },
          "balance": { "type": ["integer", "null"] },
          "lastSyncUtc": { "type": ["string", "null"], "format": "date-time" },
          "lastSyncSucceeded": { "type": ["boolean", "null"] }
        }
      },
      "Cycle": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "format": "date" },
          "end": { "type": "string", "format": "date" },
          "day": { "type": "integer" },
          "days": { "type": "integer" },
          "moneyIn": { "type": "integer" },
          "moneyOut": { "type": "integer" },
          "unrecordedIn": { "type": "integer", "description": "Part of moneyIn found only from the bank balance (no transaction reported)." },
          "unrecordedOut": { "type": "integer", "description": "Part of moneyOut found only from the bank balance (no transaction reported), e.g. card payments SePay does not record." },
          "net": { "type": "integer" },
          "projectedOut": { "type": ["integer", "null"], "description": "Null in the first two days of the cycle." }
        }
      },
      "BalancePoint": {
        "type": "object",
        "properties": { "date": { "type": "string", "format": "date" }, "balance": { "type": "integer" } }
      },
      "Upcoming": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "name": { "type": "string" },
          "amount": { "type": "integer" },
          "direction": { "$ref": "#/components/schemas/Direction" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "occurredAtUtc": { "type": "string", "format": "date-time" },
          "direction": { "$ref": "#/components/schemas/Direction" },
          "amount": { "type": "integer" },
          "balance": { "type": ["integer", "null"] },
          "content": { "type": "string" },
          "reference": { "type": "string" }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "today": { "type": "string", "format": "date" },
          "account": { "$ref": "#/components/schemas/Account" },
          "cycle": { "$ref": "#/components/schemas/Cycle" },
          "balanceHistory": { "type": "array", "items": { "$ref": "#/components/schemas/BalancePoint" } },
          "upcoming": { "type": "array", "items": { "$ref": "#/components/schemas/Upcoming" } },
          "recent": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        }
      },
      "TransactionPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "FoodKind": {
        "type": "string",
        "enum": ["Food", "Drink"]
      },
      "NutrientBasis": {
        "type": "string",
        "enum": ["Per100", "PerServing"],
        "description": "Whether the nutrition values are per 100 g/ml or per serving."
      },
      "FoodLight": {
        "type": "string",
        "enum": ["Unknown", "Green", "Amber", "Red"],
        "description": "UK FSA front-of-pack traffic light."
      },
      "FoodNoteLevel": {
        "type": "string",
        "enum": ["Info", "Caution"]
      },
      "FoodLabelReading": {
        "type": "object",
        "description": "What was read from a label. Grams, sodium in mg, energy in kcal; null = not on the label.",
        "properties": {
          "productName": { "type": "string" },
          "brand": { "type": "string" },
          "barcode": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/FoodKind" },
          "basis": { "$ref": "#/components/schemas/NutrientBasis" },
          "servingSize": { "type": ["number", "null"]},
          "netQuantity": { "type": ["number", "null"]},
          "energyKcal": { "type": ["number", "null"]},
          "fat": { "type": ["number", "null"]},
          "saturatedFat": { "type": ["number", "null"]},
          "transFat": { "type": ["number", "null"]},
          "carbohydrate": { "type": ["number", "null"]},
          "sugars": { "type": ["number", "null"]},
          "fibre": { "type": ["number", "null"]},
          "protein": { "type": ["number", "null"]},
          "salt": { "type": ["number", "null"]},
          "sodiumMg": { "type": ["number", "null"]},
          "ingredients": { "type": "string" },
          "uncertain": { "type": "array", "items": { "type": "string" } }
        }
      },
      "NutrientRating": {
        "type": "object",
        "properties": {
          "nutrient": { "type": "string", "enum": ["fat", "saturates", "sugars", "salt"]},
          "per100": { "type": ["number", "null"]},
          "perServing": { "type": ["number", "null"]},
          "light": { "$ref": "#/components/schemas/FoodLight" },
          "redByPortion": { "type": "boolean" },
          "percentOfDailyLimit": { "type": ["number", "null"]},
          "dailyLimit": { "type": "number" }
        }
      },
      "FoodNote": {
        "type": "object",
        "properties": {
          "level": { "$ref": "#/components/schemas/FoodNoteLevel" },
          "textVi": { "type": "string" },
          "textEn": { "type": "string" },
          "sourceName": { "type": "string" },
          "sourceUrl": { "type": "string" }
        }
      },
      "AdditiveFinding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "nameVi": { "type": "string" },
          "nameEn": { "type": "string" },
          "class": { "type": "string" },
          "known": { "type": "boolean" },
          "notes": { "type": "array", "items": { "$ref": "#/components/schemas/FoodNote" } }
        }
      },
      "AllergenFinding": {
        "type": "object",
        "properties": {
          "group": { "type": "string" },
          "matched": { "type": "string" },
          "mayContain": { "type": "boolean" },
          "inProfile": { "type": "boolean" }
        }
      },
      "FoodLabelAnalysis": {
        "type": "object",
        "properties": {
          "referenceVersion": { "type": "string" },
          "hasNutrition": { "type": "boolean" },
          "energyKcalPer100": { "type": ["number", "null"]},
          "transFatPer100": { "type": ["number", "null"]},
          "ratings": { "type": "array", "items": { "$ref": "#/components/schemas/NutrientRating" } },
          "additives": { "type": "array", "items": { "$ref": "#/components/schemas/AdditiveFinding" } },
          "allergens": { "type": "array", "items": { "$ref": "#/components/schemas/AllergenFinding" } },
          "flags": { "type": "array", "items": { "$ref": "#/components/schemas/FoodNote" } },
          "issues": { "type": "array", "items": { "type": "string" } },
          "redCount": { "type": "integer" },
          "amberCount": { "type": "integer" },
          "greenCount": { "type": "integer" }
        }
      },
      "FoodScan": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "householdId": { "type": "integer" },
          "userId": { "type": "integer" },
          "userName": { "type": "string" },
          "createdAtUtc": { "type": "string", "format": "date-time" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "analysis": { "$ref": "#/components/schemas/FoodLabelAnalysis" },
          "transactionId": { "type": "integer" },
          "transactionText": { "type": "string" }
        }
      },
      "FoodReadResult": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" }
        }
      },
      "FoodAnalyzeRequest": {
        "type": "object",
        "properties": {
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "save": { "type": "boolean" }
        }
      },
      "FoodAnalyzeResult": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "scanId": { "type": "integer" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "analysis": { "$ref": "#/components/schemas/FoodLabelAnalysis" }
        }
      },
      "AssistantSuggestions": {
        "type": "object",
        "properties": {"modelConfigured": {"type": "boolean"}, "suggestions": {"type": "array", "items": {"type": "string"}}}
      },
      "AssistantFact": {
        "type": "object",
        "description": "One labelled line of an answer, already formatted for display",
        "properties": {"label": {"type": "string"}, "value": {"type": "string"}}
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {"id": {"type": "integer"}, "userId": {"type": "integer"}, "role": {"type": "string", "enum": ["user", "assistant"]}, "text": {"type": "string"}, "kind": {"type": "string", "enum": ["text", "photo", "answer", "draft", "payment", "food", "help", "error"]}, "facts": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantFact"}}, "createdAtUtc": {"type": "string", "format": "date-time"}}
      },
      "AssistantHistoryPage": {
        "type": "object",
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantMessage"}}, "nextBefore": {"type": ["integer", "null"]}}
      },
      "AssistantChatRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 1000}}
      },
      "AssistantReply": {
        "type": "object",
        "properties": {"messageId": {"type": "integer"}, "kind": {"type": "string", "enum": ["answer", "draft", "payment", "food", "help", "error"]}, "text": {"type": "string"}, "facts": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantFact"}}, "suggestions": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "tool": {"type": "string", "description": "The lookup that answered: balance, cycle_summary, category, upcoming, recent, search, vehicle, help, or empty"}, "source": {"type": "string", "enum": ["rules", "ai"]}, "draft": {"oneOf": [{"$ref": "#/components/schemas/AiDraft"}, {"type": "null"}]}, "payment": {"oneOf": [{"$ref": "#/components/schemas/AiPayment"}, {"type": "null"}]}, "matches": {"type": "array", "items": {"$ref": "#/components/schemas/AiPaymentMatch"}}, "food": {"oneOf": [{"$ref": "#/components/schemas/FoodAnalyzeResult"}, {"type": "null"}]}}
      },
      "UploadedFile": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "location": {"type": "string"}, "isPending": {"type": "boolean"}}
      },
      "AiDraft": {
        "type": "object",
        "description": "A vehicle record proposed by the assistant. intent: 1 service, 2 fuel, 3 other expense, 4 odometer.",
        "properties": {"intent": {"type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6]}, "vehicleId": {"type": "integer"}, "date": {"type": "string", "description": "Short date in the server culture"}, "mileage": {"type": "integer"}, "cost": {"type": "number"}, "fuelAmount": {"type": "number"}, "isFillToFull": {"type": "boolean"}, "description": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/components/schemas/UploadedFile"}}, "attachFiles": {"type": "boolean"}}
      },
      "AiPayment": {
        "type": "object",
        "description": "A bank transfer read from a screenshot; account numbers are masked",
