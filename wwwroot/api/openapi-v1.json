{
  "openapi": "3.1.0",
  "info": {
    "title": "Sói & Thỏ – Family finance API",
    "version": "1.0.0",
    "description": "API v1 for the native apps. Sign in with OAuth 2.0 authorization code + PKCE (see /.well-known/oauth-authorization-server) and send the access token as `Authorization: Bearer ...`. Access tokens last 15 minutes; refresh tokens rotate on every use and must be stored in the Keychain. Dates are yyyy-MM-dd Vietnam calendar dates, times are UTC ISO 8601, money is whole VND. Errors are RFC 9457 problem details; a broken rule lists `errors` with a stable `code` the app translates. Writes need the Bearer header; POSTs that create something take an `Idempotency-Key` header, and PUT needs `If-Match` with the ETag from GET. Fields are only ever added in v1."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "oauth": [] }],
  "paths": {
    "/api/v1/me": {
      "get": {
        "summary": "Who is signed in",
        "operationId": "getMe",
        "responses": {
          "200": { "description": "The user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/dashboard": {
      "get": {
        "summary": "Home screen of the joint account for the current budget cycle",
        "operationId": "getDashboard",
        "responses": {
          "200": { "description": "Dashboard", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/transactions": {
      "get": {
        "summary": "Transactions of the joint account, newest first",
        "operationId": "listTransactions",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "cursor", "in": "query", "description": "nextCursor of the previous page, unchanged.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "One page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionPage" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/budget": {
      "get": {
        "summary": "Household budget: paydays, funds, limits and debts",
        "operationId": "getBudget",
        "responses": {
          "200": { "description": "The budget plan", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      },
      "put": {
        "summary": "Replace the budget plan (the joint account is kept)",
        "operationId": "saveBudget",
        "description": "If-Match must carry the ETag of the budget that was changed. 412 when the partner saved in between: load it again. Sending the same budget again is harmless.",
        "parameters": [
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } },
        "responses": {
          "200": { "description": "The saved plan", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "412": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/RuleProblem" },
          "428": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/finance/reconciliation": {
      "get": {
        "summary": "Balance changes no transaction explains, entries made by hand, and the categories",
        "operationId": "getReconciliation",
        "responses": {
          "200": { "description": "Reconciliation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reconciliation" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/finance/manual-transactions": {
      "post": {
        "summary": "Explain (part of) a gap with an entry made by hand",
        "operationId": "addManualTransaction",
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "description": "A new UUID per entry. A retry with the same key returns the first entry (200) instead of adding another.", "schema": { "type": "string", "minLength": 8, "maxLength": 64 } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManualTransactionRequest" } } } },
        "responses": {
          "200": { "description": "Already added by an earlier request with the same key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } },
          "201": { "description": "Added", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/RuleProblem" },
          "422": { "$ref": "#/components/responses/RuleProblem" }
        }
      }
    },
    "/api/v1/finance/manual-transactions/{id}": {
      "delete": {
        "summary": "Delete an entry made by hand (bank lines cannot be deleted)",
        "operationId": "deleteManualTransaction",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/finance/account/sync": {
      "post": {
        "summary": "Ask SePay for new transactions now",
        "operationId": "syncAccount",
        "description": "Within 30 seconds of a successful sync, that result is returned with recent=true instead of calling SePay again.",
        "responses": {
          "200": { "description": "Result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncResult" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/finance/receipts/read": {
      "post": {
        "summary": "Read a photo of a receipt or bank transfer with the home AI and find the gaps it may explain",
        "operationId": "readReceipt",
        "description": "Nothing is stored. To record it, explain the chosen gap with POST /api/v1/finance/manual-transactions.",
        "requestBody": {
          "required": true,
          "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } }
        },
        "responses": {
          "200": { "description": "The reading", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReceiptReading" } } } },
          "400": { "$ref": "#/components/responses/RuleProblem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/RuleProblem" },
          "503": { "$ref": "#/components/responses/RuleProblem" }
        }
      }
    },
    "/api/v1/me/sessions": {
      "get": {
        "summary": "Devices and browsers where the user is signed in, this one first",
        "operationId": "listSessions",
        "responses": {
          "200": { "description": "Sessions", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Session" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/me/sessions/{id}": {
      "delete": {
        "summary": "Sign one device out",
        "operationId": "endSession",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Signed out" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/food/read": {
      "post": {
        "summary": "Read 1 to 3 photos of one food label with the home AI (photos are not stored)",
        "operationId": "readFoodLabel",
        "description": "Needs the Authorization: Bearer header. The user must check the reading before it is analysed.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reading, or success=false with a message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodReadResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/food/analyze": {
      "post": {
        "summary": "Rate a checked reading (UK FSA traffic lights, WHO limits, additives, allergens)",
        "operationId": "analyzeFoodLabel",
        "description": "Needs the Authorization: Bearer header. save=true adds it to the household history.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodAnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The analysis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodAnalyzeResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/food/scans": {
      "get": {
        "summary": "Saved food label scans of the household, newest first",
        "operationId": "listFoodScans",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FoodScan"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/food/scans/{id}": {
      "get": {
        "summary": "One saved scan, with the caller's own allergy marks",
        "operationId": "getFoodScan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The scan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScan"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/assistant/suggestions": {
      "get": {"summary": "Questions to show as buttons when the chat opens", "operationId": "assistantSuggestions", "responses": {"200": {"description": "Suggestions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantSuggestions"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/assistant/messages": {
      "get": {"summary": "The signed-in user's own chat history (kept 30 days)", "operationId": "assistantHistory", "description": "Each page is oldest first. Pass nextBefore back as before for older messages.", "parameters": [{"name": "before", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}}], "responses": {"200": {"description": "History page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantHistoryPage"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "post": {"summary": "Send one question or vehicle log entry; returns the answer", "operationId": "assistantSend", "description": "Needs the Authorization: Bearer header. Answers only read data: amounts are computed by the server, the AI only picks which lookup to run. A vehicle entry comes back as a draft (kind=draft) that is saved only by POST /api/v1/assistant/drafts. Text is answered in Vietnamese.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantChatRequest"}}}}, "responses": {"200": {"description": "The answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantReply"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}, "429": {"description": "Too many messages (at most 20 a minute per user); see Retry-After", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}},
      "delete": {"summary": "Delete the user's whole chat history", "operationId": "assistantClear", "description": "Needs the Authorization: Bearer header.", "responses": {"204": {"description": "Deleted"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/assistant/photo": {
      "post": {"summary": "Read one photo: receipt, bank transfer or food label", "operationId": "assistantPhoto", "description": "Needs the Authorization: Bearer header. JPEG or PNG, at most 8 MB. hint=food reads it as a food label; otherwise the receipt reader runs first and falls back to the food label reader. Receipts and transfers come back as drafts to confirm; food labels are rated but not saved (save them with POST /api/v1/food/analyze after the user checks the numbers). The photo is not kept in the history.", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary"}, "hint": {"type": "string", "enum": ["", "food"]}}}}}}, "responses": {"200": {"description": "The answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssistantReply"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}, "429": {"description": "Too many messages (at most 20 a minute per user); see Retry-After", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}
    },
    "/api/v1/assistant/drafts": {
      "post": {"summary": "Save a vehicle draft from an answer, after the user checked it", "operationId": "assistantSaveDraft", "description": "Needs the Authorization: Bearer header and edit access to the vehicle.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiDraft"}}}}, "responses": {"200": {"description": "success=false with a message when it could not be saved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/assistant/payments": {
      "post": {"summary": "Mark an existing vehicle record as paid by a transfer from an answer", "operationId": "assistantAttachPayment", "description": "Needs the Authorization: Bearer header and edit access to the record's vehicle. Use one of the matches of a kind=payment answer.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AiAttachPaymentRequest"}}}}, "responses": {"200": {"description": "success=false with a message when it could not be saved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Problem"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "description": "Public clients `soitho-ios` (redirect `vn.digifusion.finance:/oauth/callback`) and `soitho-android` (redirect `vn.digifusion.soitho:/oauth/callback`), PKCE S256 required. Optional `device_name` form field on the code exchange names the device in Signed-in devices.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "refreshUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No token, or the token expired, or the device was signed out. Refresh once; if that fails, sign in again.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Problem": {
        "description": "Error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "RuleProblem": {
        "description": "The request breaks a rule; errors lists which",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/RuleProblem" } } }
      }
    },
    "headers": {
      "ETag": { "description": "Strong entity tag of the budget; send it back in If-Match.", "schema": { "type": "string" } }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      },
      "RuleProblem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/ApiIssue" } }
        }
      },
      "ApiIssue": {
        "type": "object",
        "required": ["code", "message", "args"],
        "properties": {
          "code": { "type": "string", "description": "Stable, e.g. amount_exceeds_gap; translate it in the app.", "examples": ["amount_exceeds_gap"] },
          "message": { "type": "string", "description": "English text, as a fallback." },
          "args": { "type": "array", "description": "Values for the {0}, {1} ... of the message.", "items": { "type": "string" } }
        }
      },
      "Me": {
        "type": "object",
        "required": ["id", "userName", "householdId", "isAdmin"],
        "properties": {
          "id": { "type": "integer" },
          "userName": { "type": "string" },
          "householdId": { "type": "integer" },
          "isAdmin": { "type": "boolean" }
        }
      },
      "Direction": { "type": "string", "enum": ["in", "out"] },
      "Account": {
        "type": "object",
        "required": ["linked", "bankName", "maskedNumber", "balance", "lastSyncUtc", "lastSyncSucceeded"],
        "properties": {
          "linked": { "type": "boolean" },
          "bankName": { "type": "string" },
          "maskedNumber": { "type": "string", "examples": ["•••• 6789"] },
          "balance": { "type": ["integer", "null"] },
          "lastSyncUtc": { "type": ["string", "null"], "format": "date-time" },
          "lastSyncSucceeded": { "type": ["boolean", "null"] }
        }
      },
      "Cycle": {
        "type": "object",
        "required": ["start", "end", "day", "days", "moneyIn", "moneyOut", "unrecordedIn", "unrecordedOut", "net", "projectedOut"],
        "properties": {
          "start": { "type": "string", "format": "date" },
          "end": { "type": "string", "format": "date" },
          "day": { "type": "integer" },
          "days": { "type": "integer" },
          "moneyIn": { "type": "integer" },
          "moneyOut": { "type": "integer" },
          "unrecordedIn": { "type": "integer", "description": "Part of moneyIn found only from the bank balance (no transaction reported)." },
          "unrecordedOut": { "type": "integer", "description": "Part of moneyOut found only from the bank balance (no transaction reported), e.g. card payments SePay does not record." },
          "net": { "type": "integer" },
          "projectedOut": { "type": ["integer", "null"], "description": "Null in the first two days of the cycle." }
        }
      },
      "BalancePoint": {
        "type": "object",
        "required": ["date", "balance"],
        "properties": { "date": { "type": "string", "format": "date" }, "balance": { "type": "integer" } }
      },
      "Upcoming": {
        "type": "object",
        "required": ["date", "name", "amount", "direction"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "name": { "type": "string" },
          "amount": { "type": "integer" },
          "direction": { "$ref": "#/components/schemas/Direction" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "occurredAtUtc", "direction", "amount", "balance", "content", "reference"],
        "properties": {
          "id": { "type": "integer" },
          "occurredAtUtc": { "type": "string", "format": "date-time" },
          "direction": { "$ref": "#/components/schemas/Direction" },
          "amount": { "type": "integer" },
          "balance": { "type": ["integer", "null"] },
          "content": { "type": "string" },
          "reference": { "type": "string" },
          "source": { "type": "string", "description": "webhook or api (SePay), statement (imported statement), manual (entered by hand)." },
          "category": { "type": "string", "description": "Set by hand; empty when not classified." },
          "note": { "type": "string" }
        }
      },
      "BalanceGap": {
        "type": "object",
        "description": "A change of the bank balance that no recorded transaction explains.",
        "required": ["key", "fromUtc", "toUtc", "balanceBefore", "balanceAfter", "amount", "direction", "manualEntries"],
        "properties": {
          "key": { "type": "string" },
          "fromUtc": { "type": "string", "format": "date-time" },
          "toUtc": { "type": "string", "format": "date-time" },
          "balanceBefore": { "type": "integer" },
          "balanceAfter": { "type": "integer" },
          "amount": { "type": "integer", "description": "Unexplained amount, always positive." },
          "direction": { "$ref": "#/components/schemas/Direction" },
          "manualEntries": { "type": "integer" }
        }
      },
      "Reconciliation": {
        "type": "object",
        "required": ["hasAccount", "gaps", "manualEntries", "categories"],
        "properties": {
          "hasAccount": { "type": "boolean" },
          "gaps": { "type": "array", "description": "Newest first.", "items": { "$ref": "#/components/schemas/BalanceGap" } },
          "manualEntries": { "type": "array", "description": "Newest first, at most 30.", "items": { "$ref": "#/components/schemas/Transaction" } },
          "categories": { "type": "array", "description": "\"Fund: Category\" names, ending with Other.", "items": { "type": "string" } }
        }
      },
      "ManualTransactionRequest": {
        "type": "object",
        "required": ["gapKey", "amount", "date", "category", "note"],
        "properties": {
          "gapKey": { "type": "string" },
          "amount": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "format": "date" },
          "category": { "type": "string", "maxLength": 100 },
          "note": { "type": "string", "maxLength": 300 }
        }
      },
      "SyncResult": {
        "type": "object",
        "required": ["succeeded", "added", "error", "lastRunUtc", "recent"],
        "properties": {
          "succeeded": { "type": "boolean" },
          "added": { "type": "integer" },
          "error": { "type": ["string", "null"], "examples": ["not_configured", "no_account"] },
          "lastRunUtc": { "type": ["string", "null"], "format": "date-time" },
          "recent": { "type": "boolean" }
        }
      },
      "Session": {
        "type": "object",
        "required": ["id", "kind", "deviceName", "createdUtc", "lastSeenUtc", "expiresUtc", "isCurrent"],
        "properties": {
          "id": { "type": "integer" },
          "kind": { "type": "string", "enum": ["app", "browser"] },
          "deviceName": { "type": "string" },
          "createdUtc": { "type": "string", "format": "date-time" },
          "lastSeenUtc": { "type": "string", "format": "date-time" },
          "expiresUtc": { "type": "string", "format": "date-time" },
          "isCurrent": { "type": "boolean" }
        }
      },
      "ReceiptReading": {
        "type": "object",
        "required": ["kind", "vendor", "date", "total", "content", "reference", "gaps", "alreadyRecorded"],
        "properties": {
          "kind": { "type": "string", "enum": ["receipt", "transfer", "other"] },
          "vendor": { "type": "string", "description": "Shop, or the recipient of a transfer." },
          "date": { "type": ["string", "null"], "format": "date" },
          "total": { "type": "integer" },
          "content": { "type": "string" },
          "reference": { "type": "string" },
          "gaps": { "type": "array", "description": "Money-out gaps it may explain, best match first.", "items": { "$ref": "#/components/schemas/BalanceGap" } },
          "alreadyRecorded": { "oneOf": [{ "$ref": "#/components/schemas/Transaction" }, { "type": "null" }] }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": ["today", "account", "cycle", "balanceHistory", "upcoming", "recent"],
        "properties": {
          "today": { "type": "string", "format": "date" },
          "account": { "$ref": "#/components/schemas/Account" },
          "cycle": { "$ref": "#/components/schemas/Cycle" },
          "balanceHistory": { "type": "array", "items": { "$ref": "#/components/schemas/BalancePoint" } },
          "upcoming": { "type": "array", "items": { "$ref": "#/components/schemas/Upcoming" } },
          "recent": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        }
      },
      "TransactionPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "FundKind": {
        "type": "string",
        "enum": ["shared", "personal", "debt", "emergency", "savings"]
      },
      "Budget": {
        "type": "object",
        "description": "The household budget plan. The joint account number is not included.",
        "required": ["currency", "approvalThreshold", "cycleStartDay", "incomes", "funds", "debts", "updatedAtUtc"],
        "properties": {
          "currency": { "type": "string", "examples": ["VND"] },
          "approvalThreshold": { "type": "integer", "description": "Unplanned spending at or above this needs the other partner's approval." },
          "cycleStartDay": { "type": "integer", "minimum": 1, "maximum": 31 },
          "incomes": { "type": "array", "description": "Earliest payday first.", "items": { "$ref": "#/components/schemas/BudgetIncome" } },
          "funds": { "type": "array", "items": { "$ref": "#/components/schemas/BudgetFund" } },
          "debts": { "type": "array", "description": "Earliest due day first.", "items": { "$ref": "#/components/schemas/BudgetDebt" } },
          "updatedAtUtc": { "type": "string", "format": "date-time" }
        }
      },
      "BudgetIncome": {
        "type": "object",
        "description": "A payday and where its money goes, in the order it is moved.",
        "required": ["key", "name", "amount", "payDay", "allocations"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "amount": { "type": "integer" },
          "payDay": { "type": "integer", "minimum": 1, "maximum": 31, "description": "Short months use their last day." },
          "allocations": { "type": "array", "items": { "$ref": "#/components/schemas/BudgetAllocation" } }
        }
      },
      "BudgetAllocation": {
        "type": "object",
        "required": ["fundKey", "amount"],
        "properties": { "fundKey": { "type": "string" }, "amount": { "type": "integer" } }
      },
      "BudgetFund": {
        "type": "object",
        "required": ["key", "name", "kind", "monthlyAmount", "targetAmount", "ownerUserId", "categories"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/FundKind" },
          "monthlyAmount": { "type": "integer" },
          "targetAmount": { "type": ["integer", "null"], "description": "Emergency and savings funds; null when there is none." },
          "ownerUserId": { "type": ["integer", "null"], "description": "Owner of a personal fund; null otherwise or when not assigned." },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/BudgetCategory" } }
        }
      },
      "BudgetCategory": {
        "type": "object",
        "required": ["key", "name", "monthlyLimit"],
        "properties": { "key": { "type": "string" }, "name": { "type": "string" }, "monthlyLimit": { "type": "integer" } }
      },
      "BudgetDebt": {
        "type": "object",
        "required": ["key", "name", "monthlyPayment", "dueDay", "remainingBalance", "annualInterestRate", "fundKey"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "monthlyPayment": { "type": "integer" },
          "dueDay": { "type": "integer", "minimum": 1, "maximum": 31 },
          "remainingBalance": { "type": ["integer", "null"] },
          "annualInterestRate": { "type": ["number", "null"], "description": "Percent per year." },
          "fundKey": { "type": "string" }
        }
      },
      "FoodKind": {
        "type": "string",
        "enum": ["Food", "Drink"]
      },
      "NutrientBasis": {
        "type": "string",
        "enum": ["Per100", "PerServing"],
        "description": "Whether the nutrition values are per 100 g/ml or per serving."
      },
      "FoodLight": {
        "type": "string",
        "enum": ["Unknown", "Green", "Amber", "Red"],
        "description": "UK FSA front-of-pack traffic light."
      },
      "FoodNoteLevel": {
        "type": "string",
        "enum": ["Info", "Caution"]
      },
      "FoodLabelReading": {
        "type": "object",
        "description": "What was read from a label. Grams, sodium in mg, energy in kcal; null = not on the label.",
        "properties": {
          "productName": { "type": "string" },
          "brand": { "type": "string" },
          "barcode": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/FoodKind" },
          "basis": { "$ref": "#/components/schemas/NutrientBasis" },
          "servingSize": { "type": ["number", "null"]},
          "netQuantity": { "type": ["number", "null"]},
          "energyKcal": { "type": ["number", "null"]},
          "fat": { "type": ["number", "null"]},
          "saturatedFat": { "type": ["number", "null"]},
          "transFat": { "type": ["number", "null"]},
          "carbohydrate": { "type": ["number", "null"]},
          "sugars": { "type": ["number", "null"]},
          "fibre": { "type": ["number", "null"]},
          "protein": { "type": ["number", "null"]},
          "salt": { "type": ["number", "null"]},
          "sodiumMg": { "type": ["number", "null"]},
          "ingredients": { "type": "string" },
          "uncertain": { "type": "array", "items": { "type": "string" } }
        }
      },
      "NutrientRating": {
        "type": "object",
        "properties": {
          "nutrient": { "type": "string", "enum": ["fat", "saturates", "sugars", "salt"]},
          "per100": { "type": ["number", "null"]},
          "perServing": { "type": ["number", "null"]},
          "light": { "$ref": "#/components/schemas/FoodLight" },
          "redByPortion": { "type": "boolean" },
          "percentOfDailyLimit": { "type": ["number", "null"]},
          "dailyLimit": { "type": "number" }
        }
      },
      "FoodNote": {
        "type": "object",
        "properties": {
          "level": { "$ref": "#/components/schemas/FoodNoteLevel" },
          "textVi": { "type": "string" },
          "textEn": { "type": "string" },
          "sourceName": { "type": "string" },
          "sourceUrl": { "type": "string" }
        }
      },
      "AdditiveFinding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "nameVi": { "type": "string" },
          "nameEn": { "type": "string" },
          "class": { "type": "string" },
          "known": { "type": "boolean" },
          "notes": { "type": "array", "items": { "$ref": "#/components/schemas/FoodNote" } }
        }
      },
      "AllergenFinding": {
        "type": "object",
        "properties": {
          "group": { "type": "string" },
          "matched": { "type": "string" },
          "mayContain": { "type": "boolean" },
          "inProfile": { "type": "boolean" }
        }
      },
      "FoodLabelAnalysis": {
        "type": "object",
        "properties": {
          "referenceVersion": { "type": "string" },
          "hasNutrition": { "type": "boolean" },
          "energyKcalPer100": { "type": ["number", "null"]},
          "transFatPer100": { "type": ["number", "null"]},
          "ratings": { "type": "array", "items": { "$ref": "#/components/schemas/NutrientRating" } },
          "additives": { "type": "array", "items": { "$ref": "#/components/schemas/AdditiveFinding" } },
          "allergens": { "type": "array", "items": { "$ref": "#/components/schemas/AllergenFinding" } },
          "flags": { "type": "array", "items": { "$ref": "#/components/schemas/FoodNote" } },
          "issues": { "type": "array", "items": { "type": "string" } },
          "redCount": { "type": "integer" },
          "amberCount": { "type": "integer" },
          "greenCount": { "type": "integer" }
        }
      },
      "FoodScan": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "householdId": { "type": "integer" },
          "userId": { "type": "integer" },
          "userName": { "type": "string" },
          "createdAtUtc": { "type": "string", "format": "date-time" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "analysis": { "$ref": "#/components/schemas/FoodLabelAnalysis" },
          "transactionId": { "type": "integer" },
          "transactionText": { "type": "string" }
        }
      },
      "FoodReadResult": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" }
        }
      },
      "FoodAnalyzeRequest": {
        "type": "object",
        "properties": {
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "save": { "type": "boolean" }
        }
      },
      "FoodAnalyzeResult": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "scanId": { "type": "integer" },
          "reading": { "$ref": "#/components/schemas/FoodLabelReading" },
          "analysis": { "$ref": "#/components/schemas/FoodLabelAnalysis" }
        }
      },
      "AssistantSuggestions": {
        "type": "object",
        "properties": {"modelConfigured": {"type": "boolean"}, "suggestions": {"type": "array", "items": {"type": "string"}}}
      },
      "AssistantFact": {
        "type": "object",
        "description": "One labelled line of an answer, already formatted for display",
        "properties": {"label": {"type": "string"}, "value": {"type": "string"}}
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {"id": {"type": "integer"}, "userId": {"type": "integer"}, "role": {"type": "string", "enum": ["user", "assistant"]}, "text": {"type": "string"}, "kind": {"type": "string", "enum": ["text", "photo", "answer", "draft", "payment", "food", "help", "error"]}, "facts": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantFact"}}, "createdAtUtc": {"type": "string", "format": "date-time"}}
      },
      "AssistantHistoryPage": {
        "type": "object",
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantMessage"}}, "nextBefore": {"type": ["integer", "null"]}}
      },
      "AssistantChatRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 1000}}
      },
      "AssistantReply": {
        "type": "object",
        "properties": {"messageId": {"type": "integer"}, "kind": {"type": "string", "enum": ["answer", "draft", "payment", "food", "help", "error"]}, "text": {"type": "string"}, "facts": {"type": "array", "items": {"$ref": "#/components/schemas/AssistantFact"}}, "suggestions": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "tool": {"type": "string", "description": "The lookup that answered: balance, cycle_summary, category, upcoming, recent, search, vehicle, help, or empty"}, "source": {"type": "string", "enum": ["rules", "ai"]}, "draft": {"oneOf": [{"$ref": "#/components/schemas/AiDraft"}, {"type": "null"}]}, "payment": {"oneOf": [{"$ref": "#/components/schemas/AiPayment"}, {"type": "null"}]}, "matches": {"type": "array", "items": {"$ref": "#/components/schemas/AiPaymentMatch"}}, "food": {"oneOf": [{"$ref": "#/components/schemas/FoodAnalyzeResult"}, {"type": "null"}]}}
      },
      "UploadedFile": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "location": {"type": "string"}, "isPending": {"type": "boolean"}}
      },
      "AiDraft": {
        "type": "object",
        "description": "A vehicle record proposed by the assistant. intent: 1 service, 2 fuel, 3 other expense, 4 odometer.",
        "properties": {"intent": {"type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6]}, "vehicleId": {"type": "integer"}, "date": {"type": "string", "description": "Short date in the server culture"}, "mileage": {"type": "integer"}, "cost": {"type": "number"}, "fuelAmount": {"type": "number"}, "isFillToFull": {"type": "boolean"}, "description": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/components/schemas/UploadedFile"}}, "attachFiles": {"type": "boolean"}}
      },
      "AiPayment": {
        "type": "object",
        "description": "A bank transfer read from a screenshot; account numbers are masked",
        "properties": {"amount": {"type": "number"}, "amountText": {"type": "string"}, "date": {"type": "string"}, "bank": {"type": "string"}, "reference": {"type": "string"}, "recipient": {"type": "string"}, "content": {"type": "string"}}
      },
      "AiPaymentMatch": {
        "type": "object",
        "properties": {"recordType": {"type": "integer"}, "recordId": {"type": "integer"}, "vehicleId": {"type": "integer"}, "vehicleName": {"type": "string"}, "date": {"type": "string"}, "description": {"type": "string"}, "cost": {"type": "number"}, "costText": {"type": "string"}}
      },
      "AiAttachPaymentRequest": {
        "type": "object",
        "properties": {"recordType": {"type": "integer"}, "recordId": {"type": "integer"}, "payment": {"$ref": "#/components/schemas/AiPayment"}, "files": {"type": "array", "items": {"$ref": "#/components/schemas/UploadedFile"}}, "attachFiles": {"type": "boolean"}}
      },
      "OperationResult": {
        "type": "object",
        "properties": {"success": {"type": "boolean"}, "message": {"type": "string"}}
      }
    }
  }
}
